# Configure these in your hosting provider's secret/environment settings.
# Never commit real values.
SECRET_KEY=replace-with-long-random-secret
FLASK_ENV=production
COOKIE_SECURE=true
DEMO_MODE=false

# Persistent PostgreSQL (e.g. Supabase or Neon); require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Supabase Storage: create a PRIVATE bucket named refund-attachments first.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
SUPABASE_STORAGE_BUCKET=refund-attachments

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ACCOUNTS_NOTIFICATION_EMAILS=
